            { "type": "hardBreak" },
            {
              "type": "text",
              "text": "Cuando introduce el usuario standard_user y la contraseña secret_sauce y pulsa el botón de login"
            },
            { "type": "hardBreak" },
            {
              "type": "text",
              "text": "Entonces se muestra la página de productos con el título \"Products\""
